# CrossFerry settings (`npm start` / `crossferry all` / the Docker image).
#
# Rules: CROSSFERRY_<NAME> applies to every service that understands <NAME>.
# CROSSFERRY_FORWARD_<NAME> applies to the forward proxy only, CROSSFERRY_CORS_<NAME> to the CORS
# proxy only, and those win over the shared value. CROSSFERRY_PORT is the forward proxy's port;
# the CORS proxy's is CROSSFERRY_CORS_PORT. Variables without the prefix are ignored.
#
# Every setting is listed in services/proxy/.env.example and services/cors/.env.example.

# --- both services --------------------------------------------------------
CROSSFERRY_HOST="0.0.0.0"
CROSSFERRY_BLOCK_PRIVATE_IPS="true"
CROSSFERRY_ENABLE_ACCESS_LOGS="true"
CROSSFERRY_ENABLE_ERROR_LOGS="true"
# target hosts either service may reach (exact or *.example.com); empty = any public host.
# Use CROSSFERRY_FORWARD_ALLOWED_HOSTS / CROSSFERRY_CORS_ALLOWED_HOSTS for different lists.
CROSSFERRY_ALLOWED_HOSTS=""

# --- forward proxy ---------------------------------------------------------
CROSSFERRY_FORWARD_ENABLED="true"
CROSSFERRY_PORT="3128"
CROSSFERRY_AUTH_USER="alice"
CROSSFERRY_AUTH_PASS="secret"
CROSSFERRY_ALLOWED_IPS=""
CROSSFERRY_TIMEOUT_MS="60000"

# --- CORS proxy ------------------------------------------------------------
CROSSFERRY_CORS_ENABLED="true"
CROSSFERRY_CORS_PORT="8080"
CROSSFERRY_REQUIRE_HEADERS="origin,x-requested-with"
CROSSFERRY_ALLOWED_ORIGINS=""
CROSSFERRY_ALLOWED_PORTS="80,443"
CROSSFERRY_RATE_LIMIT=""
CROSSFERRY_UPSTREAM_TIMEOUT_MS="30000"
CROSSFERRY_CORS_MAX_AGE="600"
