# CrossFerry CORS proxy, run on its own (npm start here, or `crossferry cors`).
# Every setting is a CROSSFERRY_* variable; CROSSFERRY_CORS_* forms also work and win.

# Node adapter only (Docker fixes these to 0.0.0.0:8080)
CROSSFERRY_CORS_PORT="8080"
CROSSFERRY_HOST="0.0.0.0"

# a request must carry at least one of these headers; browsers send Origin automatically.
# Empty disables the check (not recommended on a public deployment).
CROSSFERRY_REQUIRE_HEADERS="origin,x-requested-with"

# origins allowed to use the service: exact, or https://*.example.com. Empty = any origin ("*")
CROSSFERRY_ALLOWED_ORIGINS=""
CROSSFERRY_BLOCKED_ORIGINS=""

# target hosts the service may fetch: exact or *.example.com. Empty = any public host
CROSSFERRY_ALLOWED_HOSTS=""
# target ports; empty = any
CROSSFERRY_ALLOWED_PORTS="80,443"
# refuse loopback/private/link-local targets (also at DNS time on Node, Lambda and Cloud Functions)
CROSSFERRY_BLOCK_PRIVATE_IPS="true"

# "<requests> <minutes> [exempt hosts]" per origin host, cors-anywhere style; empty = no limit
CROSSFERRY_RATE_LIMIT=""
# extra exemptions: hosts or /regex/ separated by spaces
CROSSFERRY_RATE_LIMIT_EXEMPT=""

CROSSFERRY_MAX_REDIRECTS="5"
CROSSFERRY_UPSTREAM_TIMEOUT_MS="30000"
# preflight cache seconds
CROSSFERRY_CORS_MAX_AGE="600"

# request headers removed before forwarding (hop-by-hop and platform headers are always removed)
CROSSFERRY_REMOVE_HEADERS="cookie,cookie2"
# request headers to set, "name: value; name2: value2"
CROSSFERRY_SET_HEADERS=""

# answer same-origin requests with a 301 to the target instead of proxying them
CROSSFERRY_REDIRECT_SAME_ORIGIN="false"
# public address used when rewriting Location headers; derived from the request when empty
CROSSFERRY_PUBLIC_BASE_URL=""

CROSSFERRY_ENABLE_ACCESS_LOGS="true"
CROSSFERRY_ENABLE_ERROR_LOGS="true"
