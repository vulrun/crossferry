# CrossFerry forward proxy, run on its own (npm start here, or `crossferry forward`).
# Every setting is a CROSSFERRY_* variable; CROSSFERRY_FORWARD_* forms also work and win.
CROSSFERRY_PORT="3128"
# inside Docker this must stay 0.0.0.0 (deploy/docker/docker-compose.yml enforces it)
CROSSFERRY_HOST="0.0.0.0"
CROSSFERRY_AUTH_USER="alice"
CROSSFERRY_AUTH_PASS="secret"
CROSSFERRY_ALLOWED_IPS="127.0.0.1,192.168.1.10"
# target hosts: exact names, or *.domain for its subdomains (not the domain itself)
CROSSFERRY_ALLOWED_HOSTS="example.com,*.myapp.com"
# refuse loopback/private/link-local targets; set "false" to proxy to LAN hosts
CROSSFERRY_BLOCK_PRIVATE_IPS="true"
# allow starting on a public interface with no auth and no IP allowlist (dangerous)
CROSSFERRY_ALLOW_OPEN_PROXY="false"
CROSSFERRY_TIMEOUT_MS="60000"
CROSSFERRY_ENABLE_ERROR_LOGS="true"
CROSSFERRY_ENABLE_ACCESS_LOGS="true"
